# Copy to .env on the VPS (/opt/apps/seeker/.env) or .env.local for `pnpm dev`. Never commit real values.

# Turns on /admin. Use a long random password.
ADMIN_PASSWORD=
# Optional: signs admin sessions (defaults to a hash of ADMIN_PASSWORD; changing it signs everyone out).
ADMIN_SECRET=

# Email alerts for contact messages and listing requests, sent through Google Workspace
# (smtp.gmail.com). Without these they still appear in /admin.
# SMTP_PASS is a Google app password: myaccount.google.com/apppasswords (needs 2-Step Verification).
SMTP_USER=you@example.com
SMTP_PASS=
# Where alerts go (server-only, never shown on the site). Defaults to SMTP_USER.
CONTACT_TO=
